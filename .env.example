# ============================================================
# Stripe Checkout — Cartão, MB WAY, Apple Pay e Google Pay
# https://docs.stripe.com/payments/checkout
# ============================================================

# Chave secreta do modo de teste (nunca usar NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_...

# Segredo devolvido por `stripe listen` ou configurado no Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# false permite testar inscrições sem efetuar pagamentos
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ============================================================
# Base de Dados PostgreSQL
# ============================================================
DATABASE_URL=postgresql://utilizador:password@host:5432/peregrinacao?sslmode=require

# ============================================================
# Email (para implementar — envio de confirmações)
# ============================================================
# RESEND_API_KEY=
# EMAIL_FROM=peregrinacao@peregrinacaocristandade.pt
