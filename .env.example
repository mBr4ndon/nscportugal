# ============================================================
# Neon PostgreSQL
# ============================================================

# Endpoint pooled (-pooler no hostname): usado pela aplicação e Vercel
DATABASE_URL=postgresql://utilizador:password@ep-exemplo-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Endpoint direto (sem -pooler): usado apenas por `npm run db:migrate`
DIRECT_DATABASE_URL=postgresql://utilizador:password@ep-exemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ============================================================
# Inscrições e pagamentos
# ============================================================

# Define false para ocultar o formulário e bloquear novas inscrições na API.
# Se estiver ausente ou true, o formulário fica disponível.
REGISTRATIONS_ENABLED=true

# Mantém false enquanto as inscrições forem testadas sem cobranças
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Configurar apenas quando os pagamentos Stripe forem ativados
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# Email (para implementar — envio de confirmações)
# ============================================================
# RESEND_API_KEY=
# EMAIL_FROM=peregrinacao@peregrinacaocristandade.pt
